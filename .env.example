# Copy this file to .env and fill in your own values. .env is in .gitignore and is never committed.

# Alpaca market data (https://app.alpaca.markets -> API Keys). Paper-trading keys are enough for data.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# SEC EDGAR requires a User-Agent that identifies you: "Name Surname email@example.com"
# https://www.sec.gov/os/accessing-edgar-data
SEC_USER_AGENT=

# LLM (part 4). Gemini key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional, default gemini-3.5-flash-lite (the free tier allows more requests on Flash-Lite than on Flash)
GEMINI_MODEL=
# Local alternative, used when there is no Gemini key; leave as is if Ollama runs on this PC
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
