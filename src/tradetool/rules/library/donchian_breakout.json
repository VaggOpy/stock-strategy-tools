{
  "name": "Donchian breakout",
  "description": "Buy a close above the highest high of the previous 55 days, sell a close below the lowest low of the previous 20 days. Stop at 2 ATR.",
  "params": {
    "entry_len": {"default": 55, "low": 10, "high": 120, "step": 5},
    "exit_len": {"default": 20, "low": 5, "high": 60, "step": 5},
    "stop": {"default": 2, "low": 1, "high": 6, "step": 0.5}
  },
  "entry": [{"cond": "above", "left": {"price": "close"}, "right": {"ind": "DC", "length": "$entry_len", "out": "upper", "shift": 1}}],
  "exit": [{"cond": "below", "left": {"price": "close"}, "right": {"ind": "DC", "length": "$exit_len", "out": "lower", "shift": 1}}],
  "stop_atr": "$stop"
}
