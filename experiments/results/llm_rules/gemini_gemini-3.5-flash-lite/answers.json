 {
  "id": "momentum_shift",
  "rule": {
   "name": "Momentum with RSI filter",
   "params": {
    "rsi_len": {
     "default": 14,
     "low": 5,
     "high": 50,
     "step": 1
    },
    "rsi_level": {
     "default": 50,
     "low": 30,
     "high": 70,
     "step": 5
    }
   },
   "entry": [
    {
     "cond": "above",
     "left": {
      "price": "close"
     },
     "right": {
      "price": "close",
      "shift": 20
     }
    },
    {
     "cond": "above",
     "left": {
      "ind": "RSI",
      "length": "$rsi_len"
     },
     "right": {
      "value": "$rsi_level"
     }
    }
   ],
   "exit": [
    {
     "cond": "below",
     "left": {
      "price": "close"
     },
     "right": {
      "price": "close",
      "shift": 20
     }
    }
   ]
  },
  "assumptions": [
   "Shift value for price must be a fixed integer rather than a parameter variable."
  ],
  "unsupported": [],
  "attempts": 3,
  "problems": [
   [
    "entry/0/right: {'price': 'close', 'shift': '$period'} is not valid under any of the given schemas",
    "exit/0/right: {'price': 'close', 'shift': '$period'} is not valid under any of the given schemas"
   ],
   [
    "param period is defined but not used anywhere in the rule, remove it"
   ]
  ],
  "ok": true
 },
 {
  "id": "ema_rsi_band_days",
  "rule": {
   "name": "EMA and RSI strategy",
   "params": {
    "fast_ema": {
     "default": 5,
     "low": 2,
     "high": 20,
     "step": 1
    },
    "slow_ema": {
     "default": 20,
     "low": 5,
     "high": 50,
     "step": 5
    },
    "rsi_len": {
     "default": 14,
     "low": 2,
     "high": 50,
     "step": 2
    },
    "rsi_low": {
     "default": 40,
     "low": 10,
     "high": 50,
     "step": 5
    },
    "rsi_high": {
     "default": 70,
     "low": 50,
     "high": 90,
     "step": 5
    },
    "max_holding_days": {
     "default": 15,
     "low": 1,
     "high": 60,
     "step": 1
    }
   },
   "entry": [
    {
     "cond": "above",
     "left": {
      "ind": "EMA",
      "length": "$fast_ema"
     },
     "right": {
      "ind": "EMA",
      "length": "$slow_ema"
     }
    },
    {
     "cond": "above",
     "left": {
      "ind": "RSI",
      "length": "$rsi_len"
     },
     "right": {
      "value": "$rsi_low"
     }
    },
    {
     "cond": "below",
     "left": {
      "ind": "RSI",
      "length": "$rsi_len"
     },
     "right": {
      "value": "$rsi_high"
     }
    }
   ],
   "exit": [
    {
     "cond": "below",
     "left": {
      "ind": "EMA",
      "length": "$fast_ema"
     },
     "right": {
      "ind": "EMA",
      "length": "$slow_ema"
     }
    }
   ],
   "max_days": "$max_holding_days"
  },
  "assumptions": [],
  "unsupported": [],
  "attempts": 1,
  "problems": [],
  "ok": true
 },
 {
