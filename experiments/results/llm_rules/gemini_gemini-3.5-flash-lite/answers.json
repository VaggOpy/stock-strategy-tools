 {
  "id": "rsi_30_70",
  "rule": {
   "name": "RSI Oversold Overbought",
   "params": {
    "rsi_len": {
     "default": 14,
     "low": 2,
     "high": 50,
     "step": 1
    },
    "entry_level": {
     "default": 30,
     "low": 10,
     "high": 40,
     "step": 2
    },
    "exit_level": {
     "default": 70,
     "low": 60,
     "high": 90,
     "step": 2
    }
   },
   "entry": [
    {
     "cond": "below",
     "left": {
      "ind": "RSI",
      "length": "$rsi_len"
     },
     "right": {
      "value": "$entry_level"
     }
    }
   ],
   "exit": [
    {
     "cond": "above",
     "left": {
      "ind": "RSI",
      "length": "$rsi_len"
     },
     "right": {
      "value": "$exit_level"
     }
    }
   ]
  },
  "assumptions": [],
  "unsupported": [],
  "attempts": 1,
  "problems": [],
  "ok": true
