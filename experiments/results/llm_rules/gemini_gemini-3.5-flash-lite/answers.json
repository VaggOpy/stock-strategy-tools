[
 {
  "id": "ema_10_30",
  "rule": {
   "name": "EMA cross",
   "params": {
    "fast": {
     "default": 10,
     "high": 50,
     "low": 2,
     "step": 2
    },
    "slow": {
     "default": 30,
     "high": 200,
     "low": 10,
     "step": 5
    }
   },
   "entry": [
    {
     "cond": "cross_above",
     "left": {
      "ind": "EMA",
      "length": "$fast"
     },
     "right": {
      "ind": "EMA",
      "length": "$slow"
     }
    }
   ],
   "exit": [
    {
     "cond": "cross_below",
     "left": {
      "ind": "EMA",
      "length": "$fast"
     },
     "right": {
      "ind": "EMA",
      "length": "$slow"
     }
    }
   ]
  },
  "assumptions": [],
  "unsupported": [],
  "attempts": 1,
  "problems": [],
  "ok": true
 },
