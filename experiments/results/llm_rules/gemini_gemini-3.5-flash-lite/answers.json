 {
  "id": "macd_cross_stop",
  "rule": {
   "name": "MACD crossover",
   "params": {
    "fast": {
     "default": 12,
     "low": 2,
     "high": 50,
     "step": 2
    },
    "slow": {
     "default": 26,
     "low": 5,
     "high": 200,
     "step": 5
    },
    "signal": {
     "default": 9,
     "low": 2,
     "high": 50,
     "step": 2
    },
    "stop": {
     "default": 2,
     "low": 1,
     "high": 6,
     "step": 0.5
    }
   },
   "entry": [
    {
     "cond": "cross_above",
     "left": {
      "ind": "MACD",
      "fast": "$fast",
      "slow": "$slow",
      "signal": "$signal",
      "out": "macd"
     },
     "right": {
      "ind": "MACD",
      "fast": "$fast",
      "slow": "$slow",
      "signal": "$signal",
      "out": "signal"
     }
    }
   ],
   "exit": [
    {
     "cond": "cross_below",
     "left": {
      "ind": "MACD",
      "fast": "$fast",
      "slow": "$slow",
      "signal": "$signal",
      "out": "macd"
     },
     "right": {
      "ind": "MACD",
      "fast": "$fast",
      "slow": "$slow",
      "signal": "$signal",
      "out": "signal"
     }
    }
   ],
   "stop_atr": "$stop"
  },
  "assumptions": [],
  "unsupported": [],
  "attempts": 1,
  "problems": [],
  "ok": true
 },
 {
  "id": "breakout_20_10",
  "rule": {
   "name": "Donchian breakout",
   "params": {
    "entry_len": {
     "default": 20,
     "low": 5,
     "high": 100,
     "step": 5
    },
    "exit_len": {
     "default": 10,
     "low": 5,
     "high": 50,
     "step": 5
    }
   },
   "entry": [
    {
     "cond": "above",
     "left": {
      "price": "close"
     },
     "right": {
      "ind": "DC",
      "length": "$entry_len",
      "out": "upper",
      "shift": 1
     }
    }
   ],
   "exit": [
    {
     "cond": "below",
     "left": {
      "price": "close"
     },
     "right": {
      "ind": "DC",
      "length": "$exit_len",
      "out": "lower",
      "shift": 1
     }
    }
   ]
  },
  "assumptions": [],
  "unsupported": [],
  "attempts": 1,
  "problems": [],
  "ok": true
 },
