[
 {
  "id": "ema_10_30",
  "rule": {
   "name": "EMA cross",
   "params": {
    "fast": {
     "default": 10,
     "low": 2,
     "high": 50,
     "step": 2
    },
    "slow": {
     "default": 30,
     "low": 10,
     "high": 200,
     "step": 5
    }
   },
   "entry": [
    {
     "cond": "cross_above",
     "left": {
      "ind": "EMA",
      "length": "$fast"
     },
     "right": {
      "ind": "EMA",
      "length": "$slow"
     }
    }
   ],
   "exit": [
    {
     "cond": "cross_below",
     "left": {
      "ind": "EMA",
      "length": "$fast"
     },
     "right": {
      "ind": "EMA",
      "length": "$slow"
     }
    }
   ]
  },
  "assumptions": [],
  "unsupported": [],
  "attempts": 1,
  "problems": [],
  "ok": true
 },
 {
  "id": "close_sma50",
  "rule": {
   "name": "SMA crossover",
   "description": "Buy when the close crosses above the 50-day simple moving average, sell when it crosses back below.",
   "params": {
    "sma_length": {
     "default": 50,
     "high": 200,
     "low": 10,
     "step": 10
    }
   },
   "entry": [
    {
     "cond": "cross_above",
     "left": {
      "price": "close"
     },
     "right": {
      "ind": "SMA",
      "length": "$sma_length"
     }
    }
   ],
   "exit": [
    {
     "cond": "cross_below",
     "left": {
      "price": "close"
     },
     "right": {
      "ind": "SMA",
      "length": "$sma_length"
     }
    }
   ]
  },
  "assumptions": [],
  "unsupported": [],
  "attempts": 1,
  "problems": [],
  "ok": true
 },
 {
